{% extends '_layouts/cp' %}

{% set selectedSubnavItem = 'access' %}
{% set selectedItem = selectedItem ?? 'channels' %}
{% set commerceAvailable = commerceAvailable ?? false %}

{% set scopeItems = [
    { key: 'channels', label: 'Channels'|t('super-content-access'), url: url('super-content-access/access/channels'), available: true },
    { key: 'categories', label: 'Categories'|t('super-content-access'), url: url('super-content-access/access/categories'), available: true },
    { key: 'products', label: 'Products'|t('super-content-access'), url: url('super-content-access/access/products'), available: commerceAvailable },
] %}

{% block sidebar %}
    <nav class="sca-scope-nav">
        <ul>
            {% for item in scopeItems %}
                <li>
                    {% if item.available %}
                        <a href="{{ item.url }}" class="{{ selectedItem == item.key ? 'sel' : '' }}">
                            {{ item.label }}
                        </a>
                    {% else %}
                        <span class="sca-scope-nav__disabled">
                            {{ item.label }}
                            <span class="sca-scope-nav__soon">{{ 'Requires Commerce'|t('super-content-access') }}</span>
                        </span>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    </nav>
{% endblock %}
