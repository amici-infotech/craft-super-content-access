{# Shared access-policy editor controls.
   Params:
   - id: base HTML id
   - name: input name prefix (e.g. field handle or 'policy')
   - value: AccessControlValue (enabled, groupIds, hasAudiences())
   - groupOptions: [{label, value}]
   - selectedUsers: User[]
   - userElementType: User class string #}
{% set restricted = value.enabled %}
{% set showEmptyWarning = restricted and not value.hasAudiences() %}
{% set selectedGroupIds = value.groupIds %}

{% set iconGlobe %}
<svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" focusable="false">
    <path fill="currentColor" d="M8 1a7 7 0 1 0 0 14A7 7 0 0 0 8 1Zm4.9 4.5h-2a10 10 0 0 0-.9-2.3 5.5 5.5 0 0 1 2.9 2.3ZM8 2.6c.5.7.9 1.6 1.2 2.9H6.8C7.1 4.2 7.5 3.3 8 2.6ZM2.6 8c0-.5.1-1 .2-1.5h2.3a12 12 0 0 0 0 3H2.8A5.6 5.6 0 0 1 2.6 8Zm.5 2.5h2a10 10 0 0 0 .9 2.3 5.5 5.5 0 0 1-2.9-2.3ZM5.1 5.5h-2a5.5 5.5 0 0 1 2.9-2.3 10 10 0 0 0-.9 2.3ZM8 13.4c-.5-.7-.9-1.6-1.2-2.9h2.4c-.3 1.3-.7 2.2-1.2 2.9Zm1.4-4.4H6.6a10.6 10.6 0 0 1 0-2h2.8a10.6 10.6 0 0 1 0 2Zm.6 3.8a10 10 0 0 0 .9-2.3h2a5.5 5.5 0 0 1-2.9 2.3Zm1.2-3.8a12 12 0 0 0 0-3h2.3a5.6 5.6 0 0 1 0 3h-2.3Z"/>
</svg>
{% endset %}

{% set iconLock %}
<svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" focusable="false">
    <path fill="currentColor" d="M8 1a3.5 3.5 0 0 0-3.5 3.5V6H4a1.5 1.5 0 0 0-1.5 1.5v5A1.5 1.5 0 0 0 4 14h8a1.5 1.5 0 0 0 1.5-1.5v-5A1.5 1.5 0 0 0 12 6h-.5V4.5A3.5 3.5 0 0 0 8 1Zm2 5H6V4.5a2 2 0 1 1 4 0V6Z"/>
</svg>
{% endset %}

<div class="sca-field" id="{{ id }}" data-sca-field>
    <input type="hidden" name="{{ name }}[enabled]" value="0">

    <div class="sca-field__modes">
        <label class="sca-field__mode">
            <input type="radio" name="{{ name }}[enabled]" value="0"
                data-sca-mode="public" {{ restricted ? '' : 'checked' }}>
            <span class="sca-field__mode-icon">{{ iconGlobe|raw }}</span>
            <span class="sca-field__mode-text">
                <strong>{{ 'Everyone'|t('super-content-access') }}</strong>
                <small>{{ 'Anyone can view this content on the front end.'|t('super-content-access') }}</small>
            </span>
            <span class="sca-field__mode-check" aria-hidden="true"></span>
        </label>

        <label class="sca-field__mode">
            <input type="radio" name="{{ name }}[enabled]" value="1"
                data-sca-mode="restricted" {{ restricted ? 'checked' : '' }}>
            <span class="sca-field__mode-icon">{{ iconLock|raw }}</span>
            <span class="sca-field__mode-text">
                <strong>{{ 'Members only'|t('super-content-access') }}</strong>
                <small>{{ 'Only logged-in members you choose below can view this content.'|t('super-content-access') }}</small>
            </span>
            <span class="sca-field__mode-check" aria-hidden="true"></span>
        </label>
    </div>

    <div class="sca-field__audiences {{ restricted ? '' : 'hidden' }}" data-sca-audiences>
        <div class="warning with-icon sca-field__empty {{ showEmptyWarning ? '' : 'hidden' }}" data-sca-empty>
            {{ 'Choose at least one user group or user, or no one will be able to view this content.'|t('super-content-access') }}
        </div>

        <div class="sca-field__block">
            <div class="sca-field__block-head">
                <span class="sca-field__block-title">{{ 'User groups'|t('super-content-access') }}</span>
                <span class="sca-field__block-help">{{ 'Everyone in a selected group gets access.'|t('super-content-access') }}</span>
            </div>
            {% if groupOptions|length %}
                <div class="sca-field__checks">
                    {% for option in groupOptions %}
                        <label class="sca-field__check">
                            <input type="checkbox" name="{{ name }}[groupIds][]" value="{{ option.value }}"
                                data-sca-audience
                                {{ option.value in selectedGroupIds|map(v => v|string) ? 'checked' : '' }}>
                            <span class="sca-field__check-label">{{ option.label }}</span>
                        </label>
                    {% endfor %}
                </div>
            {% else %}
                <p class="sca-field__block-empty">{{ 'No user groups exist yet.'|t('super-content-access') }}</p>
            {% endif %}
        </div>

        <div class="sca-field__block">
            <div class="sca-field__block-head">
                <span class="sca-field__block-title">{{ 'Specific users'|t('super-content-access') }}</span>
                <span class="sca-field__block-help">{{ 'Grant access to individual members.'|t('super-content-access') }}</span>
            </div>
            <div class="sca-field__users" data-sca-users>
                {% include '_includes/forms/elementSelect.twig' with {
                    id: id ~ '-users',
                    name: name ~ '[userIds]',
                    elements: selectedUsers,
                    elementType: userElementType,
                    sources: ['*'],
                    criteria: { status: null },
                    limit: null,
                    showSiteMenu: false,
                } only %}
            </div>
        </div>
    </div>
</div>
